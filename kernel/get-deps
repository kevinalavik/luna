#! /bin/sh

set -e

CDPATH=
unset CDPATH

GIT_DIR= GIT_WORK_TREE= GIT_COMMON_DIR= GIT_INDEX_FILE= GIT_OBJECT_DIRECTORY=
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE GIT_OBJECT_DIRECTORY

srcdir="$(dirname "$0")"/third_party
mkdir -p $srcdir
test -z "$srcdir" && srcdir=.

cd "$srcdir"

clone_repo_commit() {
    if test -d "$2/.git"; then
        ( cd "$2" && git reset --hard )
        ( cd "$2" && git clean -f -d )
        if ! ( cd "$2" && git checkout -q $3 ); then
            rm -rf "$2"
        fi
    else
        if test -d "$2"; then
            echo "error: '$2' is not a Git repository" 1>&2
            exit 1
        fi
    fi
    if ! test -d "$2"; then
        git clone $1 "$2"
        if ! ( cd "$2" && git checkout -q $3 ); then
            rm -rf "$2"
            exit 1
        fi
    fi
}

rm -f .deps-obtained

clone_repo_commit \
    https://github.com/osdev0/freestanding-c-hdrs.git \
    freestanding-c-hdrs \
    38fed4e1e3365733ddbfa03b0a28936243ad31e9

clone_repo_commit \
    https://github.com/osdev0/cc-runtime.git \
    cc-runtime \
    9891629daf3703d0ddecd295772df7da82ab25b9

clone_repo_commit \
    https://github.com/Limine-Bootloader/limine-protocol.git \
    limine-protocol \
    3a0526b700e356f0eac1b71a77697b3fd1c707a3

clone_repo_commit \
    https://github.com/Mintsuki/Flanterm \
    flanterm \
    e231edd0e508022521c8233392aabc8ce5c9b242

clone_repo_commit \
    https://github.com/charlesnicholson/nanoprintf.git \
    nanoprintf \
    bebaecbeaf430e36a2d30d31a2fed4e098388c93

touch .deps-obtained

printf "\nDependencies obtained successfully.\n"
